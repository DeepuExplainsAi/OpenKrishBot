{
  "name": "openkrishbot-desktop",
  "productName": "OpenKrishbot",
  "version": "1.0.1",
  "description": "OpenKrishbot: a team of AI agents on your own computer. Free, local, Mera AI.",
  "author": "OpenKrishbot <DeepuExplainsAi@users.noreply.github.com>",
  "homepage": "https://github.com/DeepuExplainsAi/krishbot-ai",
  "main": "main.cjs",
  "private": true,
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "croner": "^11.0.0",
    "hono": "^4.13.17",
    "openai": "^7.53.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^25.1.8"
  },
  "scripts": {
    "prep": "node ../scripts/desktop-prep.mjs",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "ai.openkrishbot.app",
    "productName": "OpenKrishbot",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "build/icon.png",
      "server/package.json",
      "server/dist/**",
      "server/skills/**",
      "web/dist/**",
      "!**/*.map"
    ],
    "artifactName": "OpenKrishbot-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "OpenKrishbot-Setup-${version}-win-x64.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "identity": null
    },
    "linux": {
      "category": "Utility",
      "maintainer": "OpenKrishbot",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "portable": {
      "artifactName": "OpenKrishbot-Portable-${version}-win-x64.${ext}"
    }
  },
  "license": "AGPL-3.0-only"
}
