{
  "name": "openkrishbot-desktop",
  "productName": "OpenKrishBot",
  "version": "1.9.2",
  "description": "OpenKrishBot: a team of AI agents on your own computer. Free, local, Mera AI.",
  "author": "OpenKrishBot <DeepuExplainsAi@users.noreply.github.com>",
  "homepage": "https://github.com/DeepuExplainsAi/OpenKrishBot",
  "main": "main.cjs",
  "private": true,
  "dependencies": {
    "@audio/decode-mp3": "1.3.1",
    "@audio/decode-opus": "1.3.3",
    "@audio/decode-vorbis": "1.3.4",
    "@audio/decode-wav": "2.0.0",
    "@audio/decode-webm": "1.6.1",
    "@hono/node-server": "^2.1.6",
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@pedrobef/vozz": "^0.2.7",
    "@spelling-creator/spellophone": "^0.2.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "croner": "^11.0.0",
    "electron-updater": "^6.8.11",
    "hono": "^4.13.17",
    "libphonenumber-js": "^1.13.17",
    "linkedom": "^0.18.15",
    "openai": "^7.53.0",
    "qrcode": "^1.5.4",
    "tldts": "7.4.24",
    "turndown": "^7.2.5",
    "ws": "^8.22.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^25.1.8"
  },
  "scripts": {
    "prep": "node ../scripts/desktop-prep.mjs",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "ai.openkrishbot.app",
    "productName": "OpenKrishBot",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "build/icon.png",
      "build/icon.ico",
      "server/package.json",
      "server/dist/**",
      "server/skills/**",
      "server/templates/**",
      "web/dist/**",
      "!**/*.map"
    ],
    "artifactName": "OpenKrishBot-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "OpenKrishBot-Setup-${version}-win-x64.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "identity": null,
      "icon": "build/icon.png"
    },
    "linux": {
      "category": "Utility",
      "maintainer": "OpenKrishBot",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "portable": {
      "artifactName": "OpenKrishBot-Portable-${version}-win-x64.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DeepuExplainsAi",
        "repo": "OpenKrishBot"
      }
    ]
  },
  "license": "AGPL-3.0-only"
}
